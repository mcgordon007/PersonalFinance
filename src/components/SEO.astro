---
import { siteConfig } from '@/site-config'

export interface Props {
  type?: 'website' | 'article'
  title?: string
  description?: string
  url?: string
  image?: string
  datePublished?: string
  dateModified?: string
  author?: string
  tags?: string[]
}

const {
  type = 'website',
  title = siteConfig.title,
  description = siteConfig.description,
  url,
  image,
  datePublished,
  dateModified = datePublished,
  author = siteConfig.author,
  tags = [],
} = Astro.props

const siteUrl = Astro.site?.toString() || 'https://51685188.xyz'
const pageUrl = url || siteUrl
const imageUrl = image ? new URL(image, siteUrl).toString() : `${siteUrl}/open-graph.png`

// Organization Schema (Global)
const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": siteConfig.title,
  "url": siteUrl,
  "logo": {
    "@type": "ImageObject",
    "url": `${siteUrl}/favicon.ico`
  },
  "description": siteConfig.description,
  "sameAs": []
}

// Website Schema
const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": siteConfig.title,
  "description": siteConfig.description,
  "url": siteUrl,
  "publisher": {
    "@id": `${siteUrl}/#organization`
  },
  "potentialAction": {
    "@type": "SearchAction",
    "target": `${siteUrl}/search?q={search_term_string}`,
    "query-input": "required name=search_term_string"
  }
}

// Person Schema (Author)
const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": author,
  "url": `${siteUrl}/about`,
  "jobTitle": "Personal Finance Writer",
  "knowsAbout": [
    "Personal Finance",
    "Budgeting",
    "Investing",
    "Retirement Planning",
    "Credit Management",
    "Debt Management",
    "Savings Strategies",
    "Tax Planning"
  ]
}

// Article Schema (Enhanced)
const articleSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": title,
  "description": description,
  "url": pageUrl,
  "image": imageUrl,
  "author": {
    "@type": "Person",
    "name": author,
    "url": `${siteUrl}/about`
  },
  "publisher": {
    "@type": "Organization",
    "name": siteConfig.title,
    "url": siteUrl,
    "logo": {
      "@type": "ImageObject",
      "url": `${siteUrl}/favicon.ico`
    }
  },
  "datePublished": datePublished,
  "dateModified": dateModified,
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": pageUrl
  },
  "keywords": tags.join(', ')
}

// BreadcrumbList Schema
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": siteUrl
    },
    ...(type === 'article' ? [
      {
        "@type": "ListItem",
        "position": 2,
        "name": title,
        "item": pageUrl
      }
    ] : [])
  ]
}

// Combine schemas based on page type
let schemas: object[]

if (type === 'article') {
  schemas = [organizationSchema, articleSchema, personSchema, breadcrumbSchema]
} else {
  schemas = [organizationSchema, websiteSchema, personSchema]
}
---

{schemas.map((schema) => (
  <script type="application/ld+json" set:html={JSON.stringify(schema)} is:inline />
))}
